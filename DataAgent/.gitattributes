# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pkl binary
*.h5 binary
*.joblib binary
*.pth binary
*.onnx binary
*.zip binary
*.tar.gz binary
*.rar binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Python files
*.py linguist-detectable=true
*.pyw linguist-detectable=true

# Shell scripts
*.sh linguist-detectable=true

# Markdown files
*.md linguist-detectable=true

# Configuration files
*.yml linguist-detectable=true
*.yaml linguist-detectable=true
*.json linguist-detectable=true

# Exclude large files from diff
*.csv linguist-vendored
*.pkl linguist-vendored
*.h5 linguist-vendored
